{
  "name": "third-rules-engine",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "postinstall": "cd client && npm ci",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --import tsx server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "typecheck": "tsc --noEmit && cd client && tsc --noEmit",
    "test": "npm run test:new-rules && npm run test:validation && npm run test:scheduler && npm run test:reference && npm run test:packs",
    "test:new-rules": "tsx server/rules/rules.test.ts",
    "test:validation": "tsx server/rules/validation.test.ts",
    "test:scheduler": "tsx server/scheduler/buildScenario.test.ts",
    "test:reference": "tsx server/reference/reference.test.ts",
    "test:packs": "tsx server/packs/rulePack.test.ts",
    "build-packs": "tsx scripts/buildPacks.ts",
    "diff-packs": "tsx scripts/diffPacks.ts",
    "check-links": "tsx scripts/checkLinks.ts",
    "classify-citations": "tsx scripts/classifyCitations.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
