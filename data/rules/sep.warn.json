    {
      "id": "federal-warn-act-60day",
      "title": "Federal WARN Act \u2014 60-Day Notice Requirement",
      "jurisdiction": "Federal",
      "topic": "sep.warn.notice",
      "status": "active",
      "effectiveFrom": "1989-02-04",
      "appliesWhen": {
