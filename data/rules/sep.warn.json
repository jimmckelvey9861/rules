    {
      "id": "ca-warn-act",
      "title": "California Mini-WARN Act (60-day notice, 75+ employees)",
      "jurisdiction": "CA",
      "topic": "sep.warn.notice",
      "status": "active",
      "effectiveFrom": "2003-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employer.total_employees",
            "op": ">=",
            "value": 75
          },
          {
            "fact": "termination.is_mass_layoff",
            "op": "=",
            "value": true
          }
        ]
      },
      "result": {
        "type": "prohibition",
        "obligation": "sep.warn_notice",
        "params": {
          "notice_days": 60,
          "employee_threshold": 75
        },
        "summary": "California requires 60 days advance written notice before plant closing or mass layoff affecting 75+ employees."
      },
      "citations": [
        {
          "source": "Cal-WARN Act",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displayText.xhtml?lawCode=LAB&division=2.&title=&part=4.&chapter=4.&article=",
          "section": "Cal. Labor Code \u00a71400-1408",
          "kind": "statute"
        }
      ]
    },
