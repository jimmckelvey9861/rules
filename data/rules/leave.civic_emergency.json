      "id": "ak-voting-leave",
      "title": "Alaska Voting Leave",
      "jurisdiction": "AK",
      "topic": "leave.civic_emergency.voting",
      "status": "active",
      "effectiveFrom": "2000-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "AK"
          },
          {
            "fact": "leave.type",
            "op": "=",
            "value": "voting"
          }
        ]
      },
      "result": {
        "type": "warning",
        "obligation": "leave.voting",
        "params": {
          "paid": true,
          "nonworking_hours_exception": 2
        },
        "summary": "As much paid time off as needed to vote, unless the employee has 2 consecutive non-working hours while polls are open"
      },
      "citations": [
        {
          "source": "Alaska Stat. \u00a715.56.100",
          "url": "https://absencesoft.com/resources/a-comprehensive-guide-to-voting-leave-laws-by-state/",
          "kind": "statute"
        }
      ]
    },
