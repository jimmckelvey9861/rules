{
  "$schema": "../schema/rules-file.schema.json",
  "topic": "sched.shift_structure",
  "rules": [
    {
      "id": "ca-day-of-rest",
      "title": "California Day of Rest (1 day off per 7-day workweek)",
      "jurisdiction": "CA",
      "topic": "sched.shift_structure.day_of_rest",
      "status": "active",
      "effectiveFrom": "1937-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "shift.consecutive_days_worked",
            "op": ">",
            "value": 6
          }
        ]
      },
      "result": {
        "type": "prohibition",
        "obligation": "rest.weekly_day_of_rest",
        "params": {
          "max_consecutive_days": 6
        },
        "summary": "Scheduling an employee to work more than 6 consecutive days without a day of rest. Employee may voluntarily choose to work the 7th day. Exemptions for emergencies and certain industries."
      },
      "citations": [
        {
          "source": "Cal. Labor Code \u00a7551-552",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=LAB&sectionNum=551",
          "section": "\u00a7551-552",
          "kind": "statute"
        }
      ]
    },
    {
      "id": "chi-clopening-10hr",
      "title": "Chicago \u2014 10-Hour Rest Period",
      "jurisdiction": "Chicago",
      "topic": "sched.shift_structure.clopening",
      "status": "active",
      "effectiveFrom": "2020-07-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.city",
            "op": "=",
            "value": "Chicago"
          },
          {
            "fact": "employer.industry_tag",
            "op": "in",
            "value": [
              "retail",
              "restaurant",
              "hospitality",
              "fast_food",
              "healthcare",
              "hotel",
              "manufacturing",
              "warehouse"
            ]
          },
          {
            "fact": "employer.total_employees_global",
            "op": ">=",
            "value": 100
          },
          {
            "fact": "shift.hours_since_last_shift_end",
            "op": "<",
            "value": 10
          },
          {
            "fact": "schedule.employee_consented",
            "op": "=",
            "value": false
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "sched.clopening",
        "params": {
          "rest_hours": 10,
          "amount": 1.25,
          "unit": "multiplier"
        },
        "summary": "1.25 times the regular rate for a shift that begins less than 10 hours after the previous shift ended, unless the employee consents in writing"
      },
      "citations": [
        {
          "source": "Chicago Municipal Code \u00a71-25-055 (Fair Workweek Ordinance)",
          "url": "https://www.chicago.gov/city/en/depts/bacp/supp_info/fairworkweek.html",
          "section": "Chi. Mun. Code \u00a71-25-055",
          "kind": "ordinance"
        }
      ]
    },
    {
      "id": "il-day-of-rest",
      "title": "Illinois One Day Rest in Seven Act",
      "jurisdiction": "IL",
      "topic": "sched.shift_structure.day_of_rest",
      "status": "active",
      "effectiveFrom": "2023-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "IL"
          },
          {
            "fact": "shift.consecutive_days_worked",
            "op": ">",
            "value": 6
          }
        ]
      },
      "result": {
        "type": "prohibition",
        "obligation": "rest.weekly_day_of_rest",
        "params": {
          "rest_hours": 24,
          "period_days": 7
        },
        "summary": "Failing to provide at least 24 consecutive hours of rest in every consecutive 7-day period. Amended 2023: employer must also provide a meal period of 20 minutes for every 7.5-hour shift."
      },
      "citations": [
        {
          "source": "820 ILCS 140 (One Day Rest in Seven Act)",
          "url": "https://www.ilga.gov/legislation/ilcs/ilcs3.asp?ActID=1505",
          "section": "820 ILCS 140/2",
          "kind": "statute"
        }
      ]
    },
