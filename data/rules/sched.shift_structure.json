{
  "$schema": "../schema/rules-file.schema.json",
  "topic": "sched.shift_structure",
  "rules": [
    {
      "id": "brk-clopening-11hr",
      "title": "Berkeley \u2014 Rest Between Shifts (11 hours)",
      "jurisdiction": "Berkeley",
      "topic": "sched.shift_structure.clopening",
      "status": "active",
      "effectiveFrom": "2024-01-12",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.city",
            "op": "=",
            "value": "Berkeley"
          },
          {
            "fact": "employer.total_employees_city",
            "op": ">=",
            "value": 10
          },
          {
            "any": [
              {
                "all": [
                  {
                    "fact": "employer.industry_tag",
                    "op": "in",
                    "value": [
                      "retail",
                      "hotel",
                      "healthcare",
                      "manufacturing",
                      "warehouse"
                    ]
                  },
                  {
                    "fact": "employer.total_employees_global",
                    "op": ">=",
                    "value": 56
                  }
                ]
              },
              {
                "all": [
                  {
                    "fact": "employer.industry_tag",
                    "op": "in",
                    "value": [
                      "restaurant",
                      "fast_food"
                    ]
                  },
                  {
                    "fact": "employer.total_employees_global",
                    "op": ">=",
                    "value": 100
                  }
                ]
              }
            ]
          },
          {
            "fact": "shift.hours_since_last_shift_end",
            "op": "<",
            "value": 11
          },
          {
            "fact": "schedule.employee_consented",
            "op": "=",
            "value": false
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "sched.clopening",
        "params": {
          "rest_hours": 11,
          "amount": 1.5,
          "unit": "multiplier"
        },
        "summary": "1.5 times the regular rate for hours worked less than 11 hours after the previous shift ended; the employee may decline such a shift, and working it requires written consent"
      },
      "citations": [
        {
          "source": "Berkeley Municipal Code Chapter 13.102 (Fair Workweek Ordinance)",
          "url": "https://berkeley.municipal.codes/BMC/13.102.010",
          "section": "BMC 13.102 (right to rest)",
          "kind": "ordinance"
        }
      ]
    },
    {
      "id": "ca-day-of-rest",
      "title": "California Day of Rest (1 day off per 7-day workweek)",
      "jurisdiction": "CA",
      "topic": "sched.shift_structure.day_of_rest",
      "status": "active",
      "effectiveFrom": "1937-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "shift.consecutive_days_worked",
            "op": ">",
            "value": 6
          }
        ]
      },
      "result": {
        "type": "prohibition",
        "obligation": "rest.weekly_day_of_rest",
        "params": {
          "max_consecutive_days": 6
        },
        "summary": "Scheduling an employee to work more than 6 consecutive days without a day of rest. Employee may voluntarily choose to work the 7th day. Exemptions for emergencies and certain industries."
      },
      "citations": [
        {
          "source": "Cal. Labor Code \u00a7551-552",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=LAB&sectionNum=551",
          "section": "\u00a7551-552",
          "kind": "statute"
        }
      ]
    },
    {
      "id": "chi-clopening-10hr",
