    {
      "id": "ca-meal-break-first-5hr",
      "title": "California First Meal Break (>5 hours)",
      "jurisdiction": "CA",
      "topic": "meal_break",
      "status": "active",
      "effectiveFrom": "2001-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.shift_length_hours",
            "op": ">",
            "value": 5
          },
          {
            "fact": "shift.meal_break_provided",
            "op": "=",
            "value": false
          },
          {
