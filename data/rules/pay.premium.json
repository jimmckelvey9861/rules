  "rules": [
    {
      "id": "ca-reporting-time-pay",
      "title": "California Reporting Time Pay (half scheduled shift, min 2 hrs, max 4 hrs)",
      "jurisdiction": "CA",
      "topic": "pay.premium.reporting_time",
      "status": "active",
      "effectiveFrom": "2001-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.employee_reported",
            "op": "=",
            "value": true
          },
          {
            "fact": "shift.sent_home_early",
            "op": "=",
            "value": true
          },
          {
            "fact": "shift.hours_worked_at_report",
            "op": "<",
            "value": 4
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.reporting_time",
        "params": {
          "minimum_hours": 2,
          "maximum_hours": 4,
          "fraction_of_scheduled": 0.5,
          "rate_basis": "regular_rate"
        },
        "summary": "Half the scheduled shift hours at regular rate (minimum 2 hours, maximum 4 hours)"
      },
      "citations": [
        {
          "source": "IWC Wage Order 5-2001, \u00a75(A)",
          "url": "https://www.dir.ca.gov/iwc/wageorderindustries.htm",
          "section": "\u00a75(A) Reporting Time Pay",
          "kind": "regulation"
        }
      ]
    },
