    {
      "id": "ri-sunday-holiday-premium",
      "title": "Rhode Island \u2014 Sunday and Holiday Premium Pay (1.5x)",
      "jurisdiction": "RI",
      "topic": "pay.premium.holiday_sunday",
      "status": "active",
      "effectiveFrom": "2000-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "RI"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "any": [
              {
                "fact": "shift.is_sunday",
                "op": "=",
                "value": true
              },
              {
                "fact": "shift.is_holiday",
                "op": "=",
                "value": true
              }
            ]
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.holiday_sunday",
        "params": {
          "multiplier": 1.5,
          "applies_sunday": true,
          "applies_holidays": true,
          "holidays": "New Year's Day, Memorial Day, Juneteenth, July 4, Victory Day, Labor Day, Columbus Day, Veterans' Day, Thanksgiving, Christmas",
          "right_to_refuse": true,
          "excluded_from_weekly_overtime": true
        },
        "summary": "Work on a Sunday or an enumerated holiday is paid at least 1.5x the normal rate (RIGL 25-3-3; enacted 1976). Employees may refuse Sunday/holiday work except at manufacturers running seven continuous days. Exempt: 24/7 taxi and chauffeured limousine companies, T.F. Green airport car rental under lease terms; a three-shift manufacturer may start at 11 p.m. Sunday without premium for that hour. Premium hours are excluded from the weekly overtime computation (RIGL 28-12-4.1)."
      },
      "citations": [
        {
          "source": "RIGL \u00a725-3-3",
          "url": "https://webserver.rilegislature.gov/Statutes/TITLE25/25-3/25-3-3.htm",
          "section": "\u00a725-3-3 Work on Sundays and holidays",
          "kind": "statute"
        },
