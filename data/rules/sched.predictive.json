{
  "$schema": "../schema/rules-file.schema.json",
  "topic": "sched.predictive",
  "rules": [
    {
      "id": "chi-advance-notice-14day",
      "title": "Chicago \u2014 14-Day Advance Notice Required",
      "jurisdiction": "Chicago",
      "topic": "sched.predictive.change_premium",
      "status": "active",
      "effectiveFrom": "2020-07-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.city",
            "op": "=",
            "value": "Chicago"
          },
          {
            "fact": "employer.industry_tag",
            "op": "in",
            "value": [
              "retail",
              "restaurant",
              "hospitality",
              "fast_food",
              "healthcare",
              "hotel",
              "manufacturing",
              "warehouse"
            ]
          },
          {
            "fact": "employer.total_employees_global",
            "op": ">=",
            "value": 100
          },
          {
            "fact": "schedule.advance_notice_days",
            "op": "<",
            "value": 14
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.schedule_change",
        "params": {
          "amount": 1,
          "unit": "hours_pay",
          "notice_window_days": 14
        },
        "summary": "1 hour of pay per affected shift (schedule posted with less than 14 days notice)"
      },
      "citations": [
        {
          "source": "Chicago Municipal Code \u00a71-25 (Fair Workweek Ordinance)",
          "url": "https://www.chicago.gov/city/en/depts/bacp/supp_info/fairworkweek.html",
          "section": "Chi. Mun. Code \u00a71-25-050",
          "kind": "ordinance"
        }
      ]
    },
    {
      "id": "chi-change-under14-subtracted",
      "title": "Chicago \u2014 Schedule Change Premium (hours subtracted with <14 days notice)",
      "jurisdiction": "Chicago",
      "topic": "sched.predictive.change_premium",
      "status": "active",
      "effectiveFrom": "2020-07-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.city",
            "op": "=",
            "value": "Chicago"
          },
          {
            "fact": "employer.industry_tag",
            "op": "in",
            "value": [
              "retail",
              "restaurant",
              "hospitality",
              "fast_food",
              "healthcare",
              "hotel",
              "manufacturing",
              "warehouse"
            ]
          },
          {
            "fact": "employer.total_employees_global",
            "op": ">=",
            "value": 100
          },
          {
            "fact": "schedule.was_changed",
            "op": "=",
            "value": true
          },
          {
            "fact": "schedule.advance_notice_days",
            "op": "<",
            "value": 14
          },
          {
            "fact": "schedule.change_type",
            "op": "in",
            "value": [
              "hours_reduced",
              "shift_cancelled"
            ]
          },
          {
            "fact": "schedule.employee_consented",
            "op": "=",
            "value": false
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.schedule_change",
        "params": {
          "amount": 50,
          "unit": "percent_of_hours",
          "notice_window_days": 14,
          "change_type": "hours_reduced"
        },
        "summary": "50% of pay for subtracted/cancelled hours (predictability pay)"
      },
      "citations": [
        {
          "source": "Chicago Municipal Code \u00a71-25-050 (Fair Workweek Ordinance)",
          "url": "https://www.chicago.gov/city/en/depts/bacp/supp_info/fairworkweek.html",
          "section": "Chi. Mun. Code \u00a71-25-050",
          "kind": "ordinance"
