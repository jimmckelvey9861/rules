    {
      "id": "ct-tipped-hotel-restaurant-mw-2025",
      "title": "Connecticut Tipped Hotel/Restaurant Worker Cash Wage ($6.38)",
      "jurisdiction": "CT",
      "topic": "pay.tipped.cash_wage",
      "status": "active",
      "effectiveFrom": "2025-06-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CT"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "employee.tipped_status",
            "op": "=",
            "value": "tipped"
          },
          {
            "fact": "employee.job_category",
            "op": "in",
            "value": [
              "food_service",
              "hotel"
            ]
          }
        ]
      },
      "result": {
        "type": "minimum_required_value",
        "obligation": "wage.minimum",
        "params": {
          "rate": 6.38
        },
        "summary": "$6.38 per hour minimum wage"
      },
      "citations": [
        {
          "source": "Connecticut General Statutes \u00a731-62",
          "url": "https://www.ctdol.state.ct.us/wgwkstnd/wage-hour/minimum-wage.htm",
          "section": "Conn. Gen. Stat. \u00a731-62 (tipped employees)",
          "kind": "statute"
        }
      ]
    },
