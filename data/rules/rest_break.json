  "topic": "rest_break",
  "rules": [
    {
      "id": "ca-rest-break-4hr",
      "title": "California Rest Break (10 min per 4 hours worked)",
      "jurisdiction": "CA",
      "topic": "rest_break",
      "status": "active",
      "effectiveFrom": "2001-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.shift_length_hours",
            "op": ">=",
            "value": 3.5
          },
          {
            "fact": "shift.rest_break_provided",
            "op": "=",
            "value": false
          }
        ]
      },
      "result": {
        "type": "required_break",
        "breakType": "rest",
        "minimumMinutes": 10
      },
      "citations": [
        {
          "source": "California Labor Code §226.7 / IWC Order 5-2001",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=226.7.&lawCode=LAB",
          "section": "Cal. Lab. Code §226.7",
          "kind": "regulation"
        }
      ]
    },
    {
      "id": "ca-rest-break-scheduling-warning",
      "title": "California — Rest Break Required (per 4 hrs worked)",
      "jurisdiction": "CA",
      "topic": "rest_break",
      "status": "active",
      "effectiveFrom": "2001-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "shift.shift_length_hours",
            "op": ">=",
            "value": 4
          },
          {
            "fact": "shift.rest_break_provided",
            "op": "=",
            "value": false
          }
        ]
      },
      "result": {
        "type": "warning",
        "message": "California requires a paid 10-minute rest break for every 4 hours worked. Ensure rest breaks are scheduled."
      },
      "citations": [
        {
          "source": "IWC Orders / Cal. Lab. Code §226.7",
          "url": "https://www.dir.ca.gov/dlse/faq_restperiods.htm",
          "section": "IWC Orders §11-12",
          "kind": "regulation"
        }
      ]
    },
