      "title": "Federal Workweek Definition (FLSA)",
      "jurisdiction": "Federal",
      "topic": "pay.overtime.workweek_definition",
      "status": "active",
      "effectiveFrom": "1968-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          }
        ]
      },
      "result": {
        "type": "warning",
        "obligation": "pay.workweek_definition",
        "params": {
          "period_hours": 168,
          "fixed_recurring": true
        },
        "summary": "Overtime is computed over a fixed and regularly recurring period of 168 hours (seven consecutive 24-hour periods) that may begin on any day and hour; it may be changed only permanently and not to evade overtime, and hours may not be averaged across weeks"
      },
      "citations": [
        {
          "source": "29 C.F.R. \u00a7778.105 (Determining the workweek)",
          "url": "https://www.ecfr.gov/current/title-29/section-778.105",
          "section": "29 CFR 778.105",
          "kind": "regulation"
        },
        {
          "source": "Fair Labor Standards Act \u00a77(a)",
          "url": "https://www.law.cornell.edu/uscode/text/29/207",
          "section": "29 U.S.C. \u00a7207(a)",
          "kind": "statute"
        }
      ]
    },
    {
      "id": "ca-workday-workweek-definition",
      "title": "California Workday and Workweek Definition",
      "jurisdiction": "CA",
      "topic": "pay.overtime.workweek_definition",
      "status": "active",
      "effectiveFrom": "2000-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          }
        ]
      },
      "result": {
        "type": "warning",
        "obligation": "pay.workweek_definition",
        "params": {
          "period_hours": 168,
          "workday_hours": 24,
          "fixed_recurring": true
        },
        "summary": "Daily overtime is measured over a fixed 24-hour workday and weekly and seventh-day overtime over a fixed 168-hour workweek, each starting at a time the employer sets and changes only for legitimate business reasons"
      },
      "citations": [
        {
          "source": "Cal. Labor Code \u00a7500",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=LAB&sectionNum=500",
          "section": "Lab. Code \u00a7500",
          "kind": "statute"
        }
      ]
    },
    {
      "id": "ca-seventh-day-overtime-first-8",
      "title": "California Seventh Consecutive Day: 1.5x for the First 8 Hours (Labor Code \u00a7510)",
      "jurisdiction": "CA",
      "topic": "pay.overtime.seventh_day",
      "status": "active",
      "effectiveFrom": "2000-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.is_seventh_consecutive_day",
            "op": "=",
            "value": true
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.overtime",
        "params": {
          "multiplier": 1.5,
          "period": "seventh_day"
        },
        "summary": "The first 8 hours worked on the seventh consecutive day of work in a workweek are paid at 1.5x the regular rate (AB 60, effective 2000-01-01). Does not apply to employees on a valid alternative workweek schedule."
      },
      "citations": [
        {
          "source": "California Labor Code \u00a7510",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=510.&lawCode=LAB",
          "section": "Cal. Lab. Code \u00a7510(a)",
          "kind": "statute"
        }
      ]
    },
    {
      "id": "ca-seventh-day-double-time",
      "title": "California Seventh Consecutive Day: 2x After 8 Hours (Labor Code \u00a7510)",
      "jurisdiction": "CA",
      "topic": "pay.overtime.seventh_day",
      "status": "active",
      "effectiveFrom": "2000-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.is_seventh_consecutive_day",
            "op": "=",
            "value": true
          },
          {
            "fact": "shift.hours_worked_today",
            "op": ">",
            "value": 8
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.overtime",
        "params": {
          "multiplier": 2,
          "threshold_hours": 8,
          "period": "seventh_day"
        },
        "summary": "Hours over 8 on the seventh consecutive day of work in a workweek are paid at 2x the regular rate."
      },
      "citations": [
        {
          "source": "California Labor Code \u00a7510",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=510.&lawCode=LAB",
          "section": "Cal. Lab. Code \u00a7510(a)",
          "kind": "statute"
        }
      ]
    },
    {
      "id": "ky-seventh-day-overtime",
      "title": "Kentucky Seventh Day Overtime (KRS 337.050)",
      "jurisdiction": "KY",
      "topic": "pay.overtime.seventh_day",
      "status": "active",
      "effectiveFrom": "2000-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "KY"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.is_seventh_consecutive_day",
            "op": "=",
            "value": true
          },
          {
            "fact": "shift.hours_worked_this_week",
            "op": ">",
            "value": 40
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.overtime",
        "params": {
          "multiplier": 1.5,
          "period": "seventh_day"
        },
        "summary": "An employer that permits an employee to work seven days in one workweek must pay 1.5x the regular rate for all hours worked on the seventh day. Does not apply where the employee is not permitted to work more than 40 hours in the workweek (hours already paid as overtime are credited), nor to supervisors, small telephone exchanges, Railway Labor Act employees and certain carriers. Recodified 1942; in force before 2000."
      },
      "citations": [
        {
          "source": "KRS 337.050 (Time and a half for seventh day of work)",
          "url": "https://law.justia.com/codes/kentucky/chapter-337/section-337-050",
          "section": "KRS 337.050",
          "kind": "statute"
        }
      ]
    },
    {
      "id": "federal-exempt-salary-threshold",
      "title": "Federal \u2014 EAP Exemption Salary Level $684/week (29 CFR 541.600)",
      "jurisdiction": "Federal",
      "topic": "pay.overtime.exemptions",
      "status": "active",
      "effectiveFrom": "2020-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "exempt"
          },
          {
            "fact": "employee.pay_structure",
            "op": "=",
            "value": "salary"
          }
        ]
      },
      "result": {
        "type": "minimum_required_value",
        "obligation": "pay.exempt_salary_threshold",
        "params": {
          "weekly_salary": 684,
          "annual_salary": 35568,
          "basis": "fixed; 2019 rule"
        },
        "summary": "An executive, administrative or professional employee is exempt from FLSA overtime only if paid on a salary basis at least $684 a week ($35,568 a year), plus $107,432 total annual compensation for the highly compensated employee test. The 2024 rule raising these levels was vacated (E.D. Tex. 2024-11-15) and formally rescinded by DOL on 2026-05-15, so the 2019 levels remain in force. States may set higher thresholds."
      },
      "citations": [
        {
          "source": "29 CFR \u00a7541.600 (Amount of salary required)",
          "url": "https://www.law.cornell.edu/cfr/text/29/541.600",
          "section": "29 CFR \u00a7541.600",
          "kind": "regulation"
        }
      ]
    },
