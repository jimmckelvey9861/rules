    {
      "id": "ak-daily-overtime-8hr",
      "title": "Alaska Daily Overtime (>8 hours in a day = 1.5x)",
      "jurisdiction": "AK",
      "topic": "pay.overtime.daily",
      "status": "active",
      "effectiveFrom": "2010-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "AK"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.hours_worked_today",
            "op": ">",
            "value": 8
          }
        ]
      },
      "result": {
        "type": "premium_required",
        "obligation": "premium.overtime",
        "params": {
          "multiplier": 1.5,
          "threshold_hours": 8,
          "period": "day"
        },
        "summary": "Time-and-a-half for all hours worked beyond 8 in a single workday"
      },
      "citations": [
        {
          "source": "AS \u00a723.10.060",
          "url": "https://www.akleg.gov/basis/statutes.asp#23.10.060",
          "section": "AS \u00a723.10.060",
          "kind": "statute"
        }
      ]
    },
