  "rules": [
    {
      "id": "ca-rest-break-4hr",
      "title": "California Rest Break (10 min per 4 hours worked)",
      "jurisdiction": "CA",
      "topic": "sched.rest_break.paid_rest",
      "status": "active",
      "effectiveFrom": "2001-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employee.exempt_status",
            "op": "=",
            "value": "non_exempt"
          },
          {
            "fact": "shift.shift_length_hours",
            "op": ">=",
            "value": 3.5
          },
          {
            "fact": "shift.rest_break_provided",
            "op": "=",
            "value": false
          }
        ]
      },
      "result": {
        "type": "required_break",
        "obligation": "break.rest",
        "params": {
          "minimum_minutes": 10,
          "paid": true
        },
        "summary": "10-minute rest break for shifts of 3.5+ hours"
      },
      "citations": [
        {
          "source": "California Labor Code \u00a7226.7 / IWC Order 5-2001",
          "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=226.7.&lawCode=LAB",
          "section": "Cal. Lab. Code \u00a7226.7",
          "kind": "regulation"
        }
      ]
    },
    {
      "id": "ca-rest-break-scheduling-warning",
