      "id": "ca-family-medical-leave",
      "title": "California Family & Medical Leave (12 weeks, paid)",
      "jurisdiction": "CA",
      "topic": "leave.family_medical.paid_benefit",
      "status": "active",
      "effectiveFrom": "2021-01-01",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.state",
            "op": "=",
            "value": "CA"
          },
          {
            "fact": "employer.total_employees",
            "op": ">=",
            "value": 5
          },
          {
            "fact": "employee.tenure_months",
            "op": ">=",
            "value": 12
          }
        ]
      },
      "result": {
        "type": "minimum_required_value",
        "obligation": "leave.family_medical",
        "params": {
          "weeks": 12,
          "paid": true
        },
        "summary": "12 weeks of paid family and medical leave"
      },
      "citations": [
        {
          "source": "California Family Rights Act (CFRA) + CA PFL",
          "url": "https://www.dfeh.ca.gov/family-medical-pregnancy-leave/",
          "section": "Gov. Code \u00a712945.2",
          "kind": "statute"
        }
      ]
    },
