    {
      "id": "federal-fmla-eligibility",
      "title": "Federal FMLA \u2014 Employee Eligibility",
      "jurisdiction": "Federal",
      "topic": "leave.family_medical.eligibility",
      "status": "active",
      "effectiveFrom": "1993-08-05",
      "appliesWhen": {
        "all": [
          {
            "fact": "location.country",
            "op": "=",
            "value": "US"
          },
          {
            "fact": "employer.total_employees",
            "op": ">=",
            "value": 50
          },
          {
            "fact": "employee.tenure_months",
            "op": ">=",
            "value": 12
          },
          {
            "fact": "employee.hours_worked_last_12_months",
            "op": ">=",
            "value": 1250
          },
          {
            "fact": "leave.type",
            "op": "in",
            "value": [
              "family",
              "medical",
              "parental"
            ]
          }
        ]
      },
      "result": {
        "type": "warning",
        "obligation": "leave.family_medical",
        "params": {
          "weeks": 12,
          "paid": false
        },
        "summary": "Employee is FMLA-eligible: entitled to up to 12 weeks unpaid job-protected leave"
      },
      "citations": [
        {
          "source": "Family and Medical Leave Act, 29 U.S.C. \u00a72612",
          "url": "https://www.law.cornell.edu/uscode/text/29/2612",
          "section": "29 U.S.C. \u00a72612",
          "kind": "statute"
        }
