{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facts-file.schema.json",
  "title": "Fact registry",
  "description": "data/facts.json: the applicability variables rules may test. Mirrors FactDefinition in server/rules/types.ts; server/rules/facts.ts loads and indexes it.",
  "type": "object",
  "required": ["version", "categories", "facts"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categories": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } }
    },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["path", "type", "description", "category"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_0-9]+$", "description": "Dotted entity.attribute path used in appliesWhen and scenarios" },
        "type": { "enum": ["string", "number", "boolean", "date", "money", "enum"] },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "description": "One of the categories' ids" },
        "group": { "type": "string", "description": "Sub-heading within the category (e.g. '2.1 Size')" },
        "enumValues": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Required when type is enum" },
        "synonyms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Terms people use for this fact; resolved by resolveFact()" },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string" }
      }
    }
  }
}
